generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================
// MODULE: Auth & RBAC
// =========================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]
  purchaseRequests PurchaseRequest[]
  ownedLeads        Lead[]
  ownedOpportunities Opportunity[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. admin, manager, employee
  description String?
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  code        String @unique // e.g. users:read, roles:manage
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// =========================================================
// MODULE: Inventory
// =========================================================
// Product is the anchor entity most other modules (Procurement,
// Warehouse, Manufacturing, Commerce) will reference later.

model Category {
  id          String     @id @default(uuid())
  name        String
  parentId    String?
  createdAt   DateTime   @default(now())

  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryToCategory")
  products    Product[]

  @@map("categories")
}

model Product {
  id            String   @id @default(uuid())
  sku           String   @unique
  barcode       String?  @unique
  name          String
  description   String?
  categoryId    String?
  unitOfMeasure String   @default("EA") // EA, KG, L, BOX, etc.
  costPrice     Decimal  @default(0) @db.Decimal(12, 2)
  sellPrice     Decimal  @default(0) @db.Decimal(12, 2)
  reorderPoint  Int      @default(0) // trigger for replenishment (future Procurement hook)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockItems  StockItem[]
  transfers   StockTransfer[]
  adjustments StockAdjustment[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  pickListItems        PickListItem[]

  @@map("products")
}

model Location {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  type      String   @default("WAREHOUSE") // WAREHOUSE, STORE, VEHICLE, etc.
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockItems      StockItem[]
  transfersFrom   StockTransfer[]   @relation("TransferFromLocation")
  transfersTo     StockTransfer[]   @relation("TransferToLocation")
  adjustments     StockAdjustment[]
  pickLists       PickList[]

  @@map("locations")
}

// Current on-hand quantity of a product at a location. This is the
// "live balance" - StockTransfer and StockAdjustment are the ledger
// entries that update it.
model StockItem {
  productId  String
  locationId String
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([productId, locationId])
  @@map("stock_items")
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// Movement of stock between two locations.
model StockTransfer {
  id             String              @id @default(uuid())
  productId      String
  fromLocationId String
  toLocationId   String
  quantity       Int
  status         StockTransferStatus @default(PENDING)
  notes          String?
  createdAt      DateTime            @default(now())
  completedAt    DateTime?

  product      Product  @relation(fields: [productId], references: [id])
  fromLocation Location @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location @relation("TransferToLocation", fields: [toLocationId], references: [id])

  @@map("stock_transfers")
}

enum StockAdjustmentReason {
  DAMAGE
  LOSS
  COUNT_CORRECTION
  RETURN
  OTHER
}

// Manual correction to a location's stock level (not part of a transfer).
model StockAdjustment {
  id         String                 @id @default(uuid())
  productId  String
  locationId String
  delta      Int                    // positive = increase, negative = decrease
  reason     StockAdjustmentReason
  notes      String?
  createdAt  DateTime               @default(now())

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@map("stock_adjustments")
}

// =========================================================
// MODULE: Procurement
// =========================================================

model Supplier {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  bills          Bill[]

  @@map("suppliers")
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// An internal request to buy something. Needs approval before it can
// become a PurchaseOrder sent to a supplier.
model PurchaseRequest {
  id              String                 @id @default(uuid())
  requestedById   String
  status          PurchaseRequestStatus  @default(DRAFT)
  notes           String?
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  requestedBy   User                  @relation(fields: [requestedById], references: [id])
  items         PurchaseRequestItem[]
  purchaseOrder PurchaseOrder?

  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String @id @default(uuid())
  purchaseRequestId String
  productId         String
  quantity          Int
  notes             String?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])

  @@map("purchase_request_items")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// A PO sent to a supplier - either created directly or from an approved
// PurchaseRequest. Receiving items here feeds directly into Inventory stock.
model PurchaseOrder {
  id                String              @id @default(uuid())
  supplierId        String
  purchaseRequestId String?             @unique
  status            PurchaseOrderStatus @default(DRAFT)
  expectedDate      DateTime?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  purchaseRequest PurchaseRequest?     @relation(fields: [purchaseRequestId], references: [id])
  items           PurchaseOrderItem[]
  bill            Bill?

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String  @id @default(uuid())
  purchaseOrderId   String
  productId         String
  quantity          Int
  unitCost          Decimal @default(0) @db.Decimal(12, 2)
  receivedQuantity  Int     @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

// =========================================================
// MODULE: Warehouse Management
// =========================================================
// Receiving is already covered by Procurement's PO receiving flow
// (which calls StockService.receiveStock). This module covers the
// outbound side: picking, packing, and shipping.

enum PickListStatus {
  PENDING
  PICKING
  PACKED
  SHIPPED
  CANCELLED
}

// An outbound fulfillment request from a warehouse location to a
// destination (customer, retailer, another site - kept as free text
// until CRM/Commerce exist to link a real destination record).
model PickList {
  id            String         @id @default(uuid())
  locationId    String
  destination   String
  status        PickListStatus @default(PENDING)
  notes         String?
  trackingNumber String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  shippedAt     DateTime?

  location Location        @relation(fields: [locationId], references: [id])
  items    PickListItem[]

  @@map("pick_lists")
}

model PickListItem {
  id                String @id @default(uuid())
  pickListId        String
  productId         String
  quantityRequested Int
  quantityPicked    Int    @default(0)

  pickList PickList @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("pick_list_items")
}

// =========================================================
// MODULE: Finance
// =========================================================
// Starting with the foundation: a Chart of Accounts, AR (customer
// invoices), AP (supplier bills - can link back to a PurchaseOrder),
// and Payments recorded against either. A full GL posting engine
// (auto-generated journal entries per transaction) is future work -
// Account exists now so that engine has somewhere to post to later.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id        String      @id @default(uuid())
  code      String      @unique
  name      String
  type      AccountType
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@map("accounts")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// Accounts Receivable: money owed to Kasha by a customer. `customerName`
// is free text until CRM exists to link a real customer record.
model Invoice {
  id           String        @id @default(uuid())
  customerName String
  amount       Decimal       @db.Decimal(12, 2)
  status       InvoiceStatus @default(DRAFT)
  issuedDate   DateTime      @default(now())
  dueDate      DateTime?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  payments Payment[]

  @@map("invoices")
}

enum BillStatus {
  DRAFT
  APPROVED
  PAID
  OVERDUE
  CANCELLED
}

// Accounts Payable: money Kasha owes a supplier. Can optionally link to
// the PurchaseOrder it originated from.
model Bill {
  id              String     @id @default(uuid())
  supplierId      String
  purchaseOrderId String?    @unique
  amount          Decimal    @db.Decimal(12, 2)
  status          BillStatus @default(DRAFT)
  issuedDate      DateTime   @default(now())
  dueDate         DateTime?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  payments      Payment[]

  @@map("bills")
}

enum PaymentDirection {
  INCOMING // customer paying an Invoice
  OUTGOING // Kasha paying a Bill
}

model Payment {
  id        String           @id @default(uuid())
  direction PaymentDirection
  amount    Decimal          @db.Decimal(12, 2)
  method    String           @default("BANK_TRANSFER") // CASH, BANK_TRANSFER, CARD, MOBILE_MONEY, etc.
  invoiceId String?
  billId    String?
  notes     String?
  createdAt DateTime         @default(now())

  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  bill    Bill?    @relation(fields: [billId], references: [id])

  @@map("payments")
}

// =========================================================
// MODULE: CRM
// =========================================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

model Lead {
  id          String     @id @default(uuid())
  name        String
  company     String?
  email       String?
  phone       String?
  source      String?
  status      LeadStatus @default(NEW)
  notes       String?
  ownerId     String?
  convertedCustomerId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner              User?     @relation(fields: [ownerId], references: [id])
  convertedCustomer  Customer? @relation(fields: [convertedCustomerId], references: [id])

  @@map("leads")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  leadsConverted Lead[]
  opportunities  Opportunity[]

  @@map("customers")
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Opportunity {
  id                String           @id @default(uuid())
  customerId        String
  name              String
  amount            Decimal          @default(0) @db.Decimal(12, 2)
  stage             OpportunityStage @default(PROSPECTING)
  expectedCloseDate DateTime?
  ownerId           String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  owner    User?    @relation(fields: [ownerId], references: [id])

  @@map("opportunities")
}

// =========================================================
// MODULE: HR
// =========================================================

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

model Employee {
  id             String         @id @default(uuid())
  userId         String?        @unique // optional link to a login account
  employeeNumber String         @unique
  firstName      String
  lastName       String
  department     String?
  jobTitle       String?
  hireDate       DateTime       @default(now())
  status         EmployeeStatus @default(ACTIVE)
  salary         Decimal        @default(0) @db.Decimal(12, 2)
  managerId      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  manager        Employee?       @relation("EmployeeManager", fields: [managerId], references: [id])
  reports        Employee[]      @relation("EmployeeManager")
  leaveRequests  LeaveRequest[]
  payrollRecords PayrollRecord[]

  @@map("employees")
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(uuid())
  employeeId   String
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  status       LeaveStatus @default(PENDING)
  reason       String?
  approvedById String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("leave_requests")
}

enum JobOpeningStatus {
  OPEN
  CLOSED
}

model JobOpening {
  id          String           @id @default(uuid())
  title       String
  department  String?
  description String?
  status      JobOpeningStatus @default(OPEN)
  createdAt   DateTime         @default(now())

  candidates Candidate[]

  @@map("job_openings")
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model Candidate {
  id           String         @id @default(uuid())
  jobOpeningId String
  name         String
  email        String?
  phone        String?
  stage        CandidateStage @default(APPLIED)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  jobOpening JobOpening @relation(fields: [jobOpeningId], references: [id])

  @@map("candidates")
}

enum PayrollStatus {
  DRAFT
  PAID
}

// Manual payroll entries - a real payroll *engine* (tax calc, statutory
// deductions, direct deposit integration) is future work; this is the
// "integration point" the design guide calls for: record what was paid.
model PayrollRecord {
  id          String        @id @default(uuid())
  employeeId  String
  periodStart DateTime
  periodEnd   DateTime
  grossPay    Decimal       @db.Decimal(12, 2)
  deductions  Decimal       @default(0) @db.Decimal(12, 2)
  netPay      Decimal       @db.Decimal(12, 2)
  status      PayrollStatus @default(DRAFT)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("payroll_records")
}


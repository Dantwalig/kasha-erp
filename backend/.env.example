# Supabase Postgres connection.
# Get these from: Supabase dashboard -> Project Settings -> Database -> Connection string
#
# DATABASE_URL = the pooled connection (port 6543, via PgBouncer / "Transaction" mode)
#   used by the running app for normal queries.
# DIRECT_URL   = the direct connection (port 5432)
#   used only by Prisma for migrations (PgBouncer doesn't support everything migrations need).
#
# Both need ?sslmode=require and pgbouncer=true is auto-added by Supabase's copyable string
# for DATABASE_URL - copy them exactly as Supabase shows them.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# JWT secrets - change these in production!
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001
CORS_ORIGIN="http://localhost:3000"
